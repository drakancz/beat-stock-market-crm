# Vzor nastavení. Zkopíruj na .env a doplň vlastní hodnoty:
#   cp .env.example .env
#
# Na Railway se .env nepoužívá — hodnoty se zadávají v záložce Variables
# služby. Které a jak, je v CLAUDE.md v oddílu „Nasazení na Railway".
#
# Skutečný .env nikdy nepatří do repozitáře ani do Docker image.
# Heslo si vygeneruj, neopisuj ho odsud.

# --- Databáze (běží jako služba "db" v Dockeru) ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=zmen-me-na-nahodne-heslo
POSTGRES_DB=crm

# Adresa, přes kterou se aplikace připojuje. Hostitel "db" je název služby
# v compose.yaml — funguje jen uvnitř Dockeru, ne z tvého počítače.
DATABASE_URL=postgresql://crm:zmen-me-na-nahodne-heslo@db:5432/crm?schema=public

# --- Přihlašování ---
# Tajemství, kterým se podepisují sezení a šifruje dvoufázové ověření.
# Vygeneruj si vlastní, neopisuj odsud:  openssl rand -base64 32
AUTH_SECRET=zmen-me-na-nahodne-tajemstvi
# Adresa, na které aplikace běží. V produkci sem patří skutečná doména.
AUTH_URL=http://localhost:3000

# --- Odesílání e-mailů ---
# Pozvánky novým uživatelům a odkazy na obnovu hesla.
# Když SMTP_HOST nebo MAIL_FROM chybí, odesílání se nezapne a odkaz
# vydá administrátor ve Správě.
#
# Ve vývoji stačí ponechat zachytávač Mailpit (běží v Dockeru,
# schránka na http://localhost:8025) — ven neodejde nic.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=CRM Beat Stock Market <crm@beatstockmarket.cz>

# --- Amazon SES (ostrý provoz) ---
# Když jsou klíče vyplněné, systém posílá přes SES a nastavení SMTP výš
# se ignoruje. Ve vývoji je nech prázdné — pošta pak jde do Mailpitu.
#
# Klíč vytvoř v AWS pro uživatele, který smí JEN odesílat e-maily
# (oprávnění ses:SendEmail), nikdy pro účet s plnými právy.
# Region nech v Evropské unii — jdou tudy jména a adresy klientů.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=eu-central-1
# Nepovinné: sada nastavení v SES pro sledování doručenosti.
AWS_SES_CONFIGURATION_SET=

# --- Příjem klientů z webu (POST /api/leady) ---
# Klíč, kterým se web při odesílání leadu prokazuje. Posílá se v hlavičce
# X-API-Key (nebo jako Authorization: Bearer).
#
# Vygeneruj si vlastní, neopisuj odsud:
#   docker compose run --rm web node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Když je prázdný nebo kratší než 32 znaků, endpoint nepřijímá nic —
# slabý klíč by šel uhodnout. Komu se leady přiřadí, se vybírá v aplikaci
# v Nastavení → Příjem leadů.
LEAD_API_KEY=

# --- Příjem objednávek z Landing Page ---
# Klíč pro POST /api/objednavky, hlavička X-API-Key (nebo Bearer).
# Vlastní klíč, ne ten od leadů: kdyby se jeden vyzradil, druhá cesta
# do CRM zůstane zavřená. Vygeneruj si ho stejně jako ten nad tím.
#
# Když je prázdný nebo kratší než 32 znaků, objednávky se nepřijímají.
# Cena se z požadavku nikdy nebere — počítá se z ceníku v CRM.
ORDER_API_KEY=

# --- Oznámení klientům v telefonu (krok 3A) ---
# Dvojice klíčů VAPID, kterou se server prokazuje doručovacím službám
# prohlížečů (Google, Apple, Mozilla, Microsoft). Veřejný jde do prohlížeče,
# soukromý je tajemství. Vygeneruješ je v kontejneru:
#   docker compose run --rm web npx web-push generate-vapid-keys
# Když chybí, oznámení se neposílají a klientům chodí upozornění e-mailem.
# Po změně klíčů si klienti musí oznámení povolit znovu.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Denní plánovač ---
# Klíč pro POST /api/planovac (hlavička Authorization: Bearer …). Volá ho
# jednou denně plánovaná služba na Railway: upozornění na konec členství
# a úkoly na prodloužení. Aspoň 32 znaků, vygeneruj jako LEAD_API_KEY.
# Když je prázdný, plánovač nepřijímá nic.
PLANOVAC_KEY=

# --- SmartEmailing ---
# Nový klient se souhlasem s marketingem se zapíše do seznamu odběratelů.
# Který seznam to je a jestli je propojení zapnuté, se vybírá v aplikaci
# v sekci SmartEmailing → Nastavení propojení.
#
# Jméno je e-mail, kterým se do SmartEmailingu přihlašuješ. Klíč najdeš
# ve SmartEmailingu v Nastavení účtu → API klíče. Když jedno z toho chybí,
# nic se neodesílá.
SMARTEMAILING_USERNAME=
SMARTEMAILING_API_KEY=

# Heslo, kterým se SmartEmailing prokazuje, když CRM posílá odhlášené
# kontakty (webhook na POST /api/smartemailing/odhlaseni). Aspoň 32 znaků.
# CRM ho SmartEmailingu předá samo tlačítkem Zapnout příjem odhlášení
# v Nastavení propojení. Když ho změníš, příjem vypni a znovu zapni.
#
# Vygeneruj si vlastní, neopisuj odsud:
#   docker compose run --rm web node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Když je prázdný, adresa nepřijímá nic. Webhook funguje jen na veřejné
# adrese s https (AUTH_URL) — z localhostu se k němu SmartEmailing nedostane.
SMARTEMAILING_WEBHOOK_SECRET=

# --- Sentry (hlášení chyb) ---
# Adresa projektu v Sentry (DSN). Najdeš ji v Sentry v nastavení projektu
# pod „Client Keys (DSN)" a vypadá takhle:
#   https://abc123@o123456.ingest.de.sentry.io/7654321
#
# Když je prázdná, hlášení chyb je vypnuté a aplikace běží normálně dál.
# Hlásí se jen z nasazené aplikace, při vývoji nikdy (Jakub, 17. 9. 2026).
#
# Co se posílá: druh chyby, kde vznikla, vnitřní ID a role přihlášeného.
# Co se neposílá NIKDY: jména, e-maily, telefony ani obsah portfolia —
# hlídá to src/lib/sentry/nastaveni.ts (security_warnings.md, pravidlo 8).
NEXT_PUBLIC_SENTRY_DSN=

# Mapy zdrojového kódu do Sentry (nepovinné, Jakub 17. 9. 2026).
# Bez nich hlášení odkazuje na přeložené soubory; s nimi uvidíš v Sentry
# název souboru a řádek. Posílají se jen při sestavení produkční verze,
# a to MIMO Docker — Dockerfile klíč nepřebírá (Railway neumí předat
# tajemství tak, aby nezůstalo v obrazu). Viz CLAUDE.md, Sentry.
#
# SENTRY_AUTH_TOKEN je TAJNÝ — na rozdíl od DSN. Vytvoř ho v Sentry
# v Settings → Auth Tokens jako organizační (sntrys_…) a dej mu jediné
# oprávnění `project:releases`. Nikdy ho nepředávej přes ARG.
#
# SENTRY_URL je adresa serveru podle regionu účtu — pro EU de.sentry.io.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=https://de.sentry.io
SENTRY_AUTH_TOKEN=

# --- Zálohy databáze ---
# Adresa databáze, ze které se dělá záloha:
#   docker compose --profile zaloha run --rm zaloha
#
# Pro zálohu nasazeného CRM sem patří VEŘEJNÁ adresa databáze z Railway —
# služba Postgres → Variables → DATABASE_PUBLIC_URL. Vnitřní DATABASE_URL
# (hostitel končí na .railway.internal) z tvého počítače nefunguje.
# Pro zálohu vývojové databáze v Dockeru sem dej totéž co do DATABASE_URL.
#
# Veřejný přístup k databázi na Railway po záloze zase vypni
# (Postgres → Settings → Networking).
ZALOHA_DATABASE_URL=

# Adresa databáze, DO KTERÉ se obnovuje ze zálohy. Schválně je to jiná
# proměnná než ZALOHA_DATABASE_URL — ať se omylem nepřepíše databáze,
# ze které se zrovna zálohovalo. Obnova se navíc potvrzuje názvem databáze.
OBNOVA_DATABASE_URL=

# --- Nahrávání souborů (UploadThing) ---
# Token z uploadthing.com → tvoje aplikace → API Keys. Bez něj se
# nahrávání tiše vypne a v profilu se tlačítko Nahrát neukáže.
#
# POZOR: na free tarifu jsou nahrané soubory u UploadThingu VEŘEJNÉ
# (soukromé soubory i výběr regionu jsou až od placeného tarifu) a leží
# v USA. Jakub o tom 21. 9. 2026 rozhodl vědomě — podrobnosti a co z toho
# plyne jsou v security.md. Soubor se v aplikaci otevírá jen přes
# /api/soubory/[id], které ověří přihlášení; adresa u UploadThingu se
# nikam nevydává.
UPLOADTHING_TOKEN=

# --- Úložiště příloh S3 / Cloudflare R2 v EU (od 4. 10. 2026) ---
# Když je vyplněné, nové přílohy jdou sem (soukromě, v EU) místo do
# UploadThingu. Ve vývoji to nech prázdné — compose.yaml pak použije
# místní S3Mock. Na serveru: R2 → bucket „crm-prilohy" s jurisdikcí EU,
# API token s právem Object Read & Write jen k tomuhle bucketu.
#   S3_ENDPOINT=https://<id účtu>.eu.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
