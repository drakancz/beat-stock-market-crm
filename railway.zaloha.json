{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.zaloha",
    "watchPatterns": [
      "Dockerfile.zaloha",
      "scripts/zaloha-automaticka.sh",
      "scripts/adresa-databaze.sh"
    ]
  },
  "deploy": {
    "cronSchedule": "0 1 * * *",
    "restartPolicyType": "NEVER"
  }
}
