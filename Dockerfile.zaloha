# Obraz pro automatickou zálohu databáze (4. 10. 2026).
#
# Na Railway z něj běží samostatná plánovaná služba (railway.zaloha.json),
# s aplikací nesdílí nic. Verze Postgresu musí sedět s databází — pg_dump
# neumí zálohovat z novějšího serveru (CLAUDE.md, Zálohy databáze).
FROM postgres:18.6-trixie

# aws = nahrávání do úložiště S3 / Cloudflare R2, GnuPG už v obrazu je.
RUN apt-get update \
  && apt-get install -y --no-install-recommends awscli ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY scripts/adresa-databaze.sh scripts/zaloha-automaticka.sh /skripty/

# Ne pod rootem (security_warnings.md, pravidlo 10).
USER postgres
WORKDIR /tmp

CMD ["sh", "/skripty/zaloha-automaticka.sh"]
