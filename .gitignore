# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright: přihlášení zkušebních účtů, výsledky a zpráva z běhu
/e2e/.stav
/e2e/vysledky
/e2e/zprava
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — tajemství nikdy do repozitáře (viz security_warnings.md)
.env*
# vzor bez skutečných hodnot naopak commitujeme
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generovaný klient Prismy
/src/generated

# snímky obrazovky ze zkoušek v prohlížeči — mohou na nich být data z vývojové databáze
/snimky

# nástroj na migrace — instaluje se jen v Dockeru
/migrace/node_modules

# zálohy databáze — jsou v nich osobní údaje klientů a otisky hesel
/zalohy
